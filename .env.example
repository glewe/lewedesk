# LeweDesk - Lewe Ticket Management Environment Configuration

# APP
APP_NAME="LeweDesk"
APP_ENV=production
# Address of LeweDesk without a trailing slash (used in emails and for CORS)
APP_URL=https://desk.example.com

# DATABASE
DB_HOST=127.0.0.1
DB_NAME=lewedesk
DB_USER=root
DB_PASS=""
DB_PORT=3306

# SECURITY
SESSION_EXPIRATION=7200

# MAIL SETTINGS
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=notifications@example.com
MAIL_PASS=password
MAIL_FROM=notifications@example.com

# EMAIL TO TICKET (optional)
# Set MAILIN_YES=1 to turn mails to the support mailbox into issues, and replies to notification mails into comments.
# This is the IMAP mailbox that is read; the SMTP settings above are for sending. Host, port and encryption differ from
# SMTP, the account is normally the same mailbox, so MAILIN_USER and MAILIN_PASS default to MAIL_USER and MAIL_PASS.
# The other options are system settings (Settings > Email to ticket). Needs a valid license after the trial period.
# Do not put comments on the same line as a value.
#
# MAILIN_YES=0
# MAILIN_HOST=imap.example.com
# MAILIN_PORT: typ. 993 (implicit TLS) or 143 (STARTTLS), default 993
# MAILIN_PORT=993
# MAILIN_ENCRYPTION: ssl (implicit TLS), tls (STARTTLS) or none; default follows the port
# MAILIN_ENCRYPTION=ssl
# MAILIN_USER and MAILIN_PASS only if they differ from MAIL_USER and MAIL_PASS
# MAILIN_USER=support@example.com
# MAILIN_PASS=password
# MAILIN_FOLDER: the folder that is read, default INBOX
# MAILIN_FOLDER=INBOX
# MAILIN_PROCESSED_FOLDER: mails that became an issue or a comment are moved here (created if missing), default Processed
# MAILIN_PROCESSED_FOLDER=Processed
# MAILIN_REJECTED_FOLDER: mails that were refused are moved here (created if missing), default Rejected
# MAILIN_REJECTED_FOLDER=Rejected
# MAILIN_VALIDATE_CERT: 0 skips the certificate check (self-signed test servers only), default 1
# MAILIN_VALIDATE_CERT=1
# MAILIN_AUTH_SERVER: the name of YOUR mail server in the Authentication-Results header it adds to every incoming mail
# (SPF/DKIM/DMARC). Anybody can write such a header into a mail; only this server's is believed. Find the name with
# php scripts/mailin-auth-sample.php .env. Without it no result is believed: then senders are accepted only with the
# setting mailin_trust_sender, and agents and administrators cannot send mails at all. IONOS: kundenserver.de
# MAILIN_AUTH_SERVER=kundenserver.de

# TWO FACTOR AUTHENTICATION
# Key that encrypts the TOTP secrets at rest (32 random bytes, base64). Do NOT change it once users have set up 2FA.
# Generate one with: php -r "echo base64_encode(random_bytes(32));"
TWOFA_ENCRYPTION_KEY=replace_this_with_your_totp_encryption_key
# Emergency only: true lets all administrators log in without a code (see GitBook)
DISABLE_ADMIN_2FA=false

# LOGIN THROTTLE
# Per client address (REMOTE_ADDR): wrong passwords at login and requests to register / reset password are counted.
# When AUTH_THROTTLE_MAX events happen within AUTH_THROTTLE_WINDOW seconds, the address gets HTTP 429 until the window
# has passed. 0 switches the limit off. Behind a reverse proxy the web server must pass the real client address on.
AUTH_THROTTLE_MAX=10
AUTH_THROTTLE_WINDOW=900

# LICENSE (LeweLic license server)
# install.php writes LICENSE_SERVER and LICENSE_ITEM; LICENSE_SECRET is part of your license information.
LICENSE_SERVER=https://lewelic.lewe.com
LICENSE_ITEM=LeweDesk
LICENSE_SECRET=
# Without a valid license the application first runs 14 days with a warning (trial or grace period), then in a limited
# mode (see the License page of the manual). Set LICENSE_LOCK=1 to lock the application instead: then only
# administrators can log in after the grace period (expired, blocked or trial over).
# LICENSE_LOCK=0

# LDAP AUTHENTICATION (optional)
# Set LDAP_YES=1 to enable LDAP authentication for all users except 'admin'.
# The user 'admin' always authenticates against the LeweDesk database.
# LDAP is used for authentication only: users must already exist in LeweDesk, and no data is copied from LDAP.
# Keeping these settings in .env ensures they survive application upgrades.
# Do not put comments on the same line as a value.
#
# LDAP_YES=0
# LDAP_ADS=0
# LDAP_HOST=ldap.example.com
# LDAP_PORT=389
# LDAP_PASS=secret_password
# LDAP_DIT=cn=read-only-admin,dc=example,dc=com
# LDAP_SBASE=dc=example,dc=com
# LDAP_TLS: 0 = none, 1 = STARTTLS on LDAP_PORT (typ. 389), 2 = LDAPS (implicit TLS, typ. port 636)
# LDAP_TLS=0
# LDAP_CHECK_ANONYMOUS_BIND=0
# LDAP_SEARCH_BIND=0
# LDAP_USER_ATTR: attribute that holds the username; default uid, or sAMAccountName when LDAP_ADS=1
# LDAP_USER_ATTR=uid
# LDAP_TIMEOUT: network timeout in seconds, default 5
# LDAP_TIMEOUT=5

# OIDC AUTHENTICATION (optional)
# Set OIDC_YES=1 to enable OpenID Connect (OIDC) single sign-on.
# When enabled, local and LDAP login are disabled for all users except 'admin'.
# The user 'admin' always authenticates against the LeweDesk database.
# OIDC is used for authentication only: users must already exist in LeweDesk, and no data is copied from the provider.
# The username of the LeweDesk user must equal the preferred_username claim of the provider.
# Keeping these settings in .env ensures they survive application upgrades.
# Do not put comments on the same line as a value.
#
# OIDC_YES=0
# OIDC_PROVIDER_URL=https://keycloak.example.com/realms/lewedesk
# OIDC_CLIENT_ID=lewedesk
# OIDC_CLIENT_SECRET=your-client-secret-here
# OIDC_REDIRECT_URI=https://your-lewedesk-server.com/api/auth/oidc/callback
# OIDC_TIMEOUT: network timeout in seconds, default 5
# OIDC_TIMEOUT=5
# OIDC_VERIFY_TLS: 1 = verify the TLS certificate of the provider (default), 0 = do not (testing only)
# OIDC_VERIFY_TLS=1
